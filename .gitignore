# k3d-generated project-local kubeconfig — contains cluster access credentials (NFR-ISO-003)
.k3d/

# Rosetta agent scratch space — not a project deliverable
agents/TEMP/

# Postgres credentials file — generated by just deploy; never committed (FR-DB-003)
.k3d/postgres.env

# Garage config (embeds its rpc_secret/admin_token/metrics_token) and dev access
# key credentials — generated by task deploy / task init-garage; never committed
.k3d/garage.toml
.k3d/garage.env

# Corporate CA bundle copies used during Docker build — temp files, gitignored.
# The .docker/corp-ca/ directories themselves ARE committed (empty, via
# .gitkeep) so the Dockerfiles' bind mount always has something to mount.
dictionary/.docker/corp-ca/_corp-ca.pem
phraseforge/.docker/corp-ca/_corp-ca.pem

# OS cruft
.DS_Store

# Agent scratch space (/code) — never a project deliverable
.agent/
