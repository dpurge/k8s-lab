# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM rust:1.97-alpine AS build

# musl-dev: required for linking the static musl binary.
# file: used below to verify static linkage (PLAN T-7.1 AC) — not copied to runtime stage.
# ca-certificates: installed conditionally for corporate networks (see below).
RUN apk add --no-cache musl-dev file

WORKDIR /app

# Trust the corporate CA bundle if present in the build context (non-empty file).
# `just build-image` places a copy or empty placeholder at phraseforge-api/_corp-ca.pem.
# NOTE: _corp-ca.pem is generated by `just build-image` (or an empty placeholder is used).
# Running `docker build phraseforge-api/` directly will fail here — use `just build-image` instead.
COPY _corp-ca.pem /tmp/_corp-ca.pem
RUN if [ -s /tmp/_corp-ca.pem ]; then \
        apk add --no-cache ca-certificates && \
        cp /tmp/_corp-ca.pem /usr/local/share/ca-certificates/corp.crt && \
        update-ca-certificates; \
    fi

# Dependency cache layer: copy manifests and fetch crates before copying source.
# This layer is invalidated only when Cargo.toml or Cargo.lock change, not on source edits.
COPY Cargo.toml Cargo.lock ./
RUN cargo fetch --locked

# Copy source and migrations, then build both binaries in release mode.
COPY src/ ./src/
COPY migrations/ ./migrations/

# Release profile (strip/lto/codegen-units=1/panic=abort) is declared in Cargo.toml
# [profile.release] — not in RUSTFLAGS. Plain --release picks it up automatically.
RUN cargo build --release --locked --bins

# Verify static linking (PLAN T-7.1 AC)
RUN file target/release/phraseforge-api | grep -q "statically linked"
RUN file target/release/phraseforge-migrate | grep -q "statically linked"

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
# scratch: zero OS layer → immune to corporate TLS-inspection caveat (SPECS §3 notes).
# Static musl resolves DNS from the injected /etc/resolv.conf — no libc resolver needed.
FROM scratch

# Copy both binaries. Source path is target/release/ (no --target on Alpine, default musl).
COPY --from=build /app/target/release/phraseforge-api  /phraseforge-api
COPY --from=build /app/target/release/phraseforge-migrate /phraseforge-migrate

# securityContext.runAsNonRoot: true + runAsUser: 65532 works on scratch (numeric UID).
EXPOSE 8080

ENTRYPOINT ["/phraseforge-api"]
