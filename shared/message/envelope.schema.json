{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k8s-lab.local/schemas/message-envelope-1.json",
  "title": "Message envelope, schema_version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "correlation_id", "from", "to", "created_at", "operation"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/uuid"},
    "type": {"enum": ["request", "response", "event", "error"]},
    "correlation_id": {"$ref": "#/$defs/uuid"},
    "from": {"$ref": "#/$defs/app_name"},
    "to": {"$ref": "#/$defs/app_name"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {"type": "string"},
        "task_id": {"type": "string"}
      }
    },
    "summary": {"type": "string", "maxLength": 500},
    "payload": {"type": "object"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["invalid_message", "unknown_operation", "invalid_payload", "not_found", "too_large", "timeout", "unavailable", "internal"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000},
        "retryable": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "request"}}, "required": ["type"]},
      "then": {"required": ["payload"]}
    },
    {
      "if": {"properties": {"type": {"const": "error"}}, "required": ["type"]},
      "then": {"required": ["error"]},
      "else": {"properties": {"error": false}}
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "app_name": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"}
  }
}
