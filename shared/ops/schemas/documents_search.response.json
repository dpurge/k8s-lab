{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k8s-lab.local/schemas/ops/documents_search.response-1.json",
  "title": "documents_search response",
  "type": "object",
  "additionalProperties": false,
  "required": ["documents"],
  "properties": {
    "documents": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/document"}},
    "total": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "tags", "score", "url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "score": {"type": "number"},
        "url": {"type": "string"}
      }
    }
  }
}
